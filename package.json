{
  "name": "tpocus-app",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json",
    "check:client-imports": "node scripts/check-client-content-imports.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:schema": "node scripts/validate-schema.mjs",
    "validate": "npm run validate:content && npm run validate:schema && npm run check:client-imports",
    "pretest": "npm run validate",
    "prebuild": "npm run validate"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.4",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "^3.3.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^12.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
