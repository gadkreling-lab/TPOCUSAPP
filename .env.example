# Variáveis de ambiente necessárias em produção (Vercel → Project Settings →
# Environment Variables). Nenhuma delas deve ir para o código-fonte nem para o
# histórico do git — copie este arquivo para `.env` local só se for rodar `vercel dev`,
# e nunca commite o `.env` de verdade (.gitignore já bloqueia isso).

# Segredo usado para assinar os tokens de sessão (HMAC-SHA256) — ver
# api/_lib/token.ts. Gere algo aleatório e longo, por exemplo:
#   openssl rand -base64 32
TOKEN_SECRET=

# Upstash Redis (controle de acesso — códigos, prazos, aparelhos) — ver
# ARQUITETURA.md §6 e api/_lib/kv.ts. Instale a integração Redis do Vercel
# Marketplace no projeto; ela preenche estas duas automaticamente.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sem estas variáveis definidas, api/_lib/kv.ts cai para um armazenamento em memória
# (MemoryKV) — só serve para dev local/testes, nunca para produção (o estado não
# persiste nem é compartilhado entre instâncias de função serverless reais).
